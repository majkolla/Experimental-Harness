// Study configuration: Experiment Specification v1.3 (SYNTHETIC mode).
//
// Offline self-test: nine synthetic models (provider synthetic_world) and a mock Vul4J.
// No network and no paid calls are possible: validation refuses any real provider here.
// Model ids, checksums and costs below are synthetic labels, not real values.
//
// Every value still equal to "TO_PIN_AT_FREEZE" must be pinned before a live run;
// hp/study_config.py refuses to load a live config while any placeholder remains.
// Comments marked [default ...] are values the specification marks as defaults;
// [v1.0 §n] means the marker was taken from spec v1.0 and must be checked against v1.3.
{
  "study": "llm-security-review",
  "spec_version": "1.3",
  "mode": "synthetic",
  "seed": 20260930,                                   // §6 global seed; every derived seed is logged
  "split": {"file": "docs/spec/proposed_split.json",
            "sha256": "b0ffb4cf5723e4c21480cef1b704ed6abdbf889d4f072a2316986a04219445d7"},
  "paths": {"runs": "runs/synthetic", "inputs": "runs/synthetic/inputs"},
  "prompts": {"review": "prompts/review_v13.md", "generate": "prompts/generate_v13.md"},

  // Nine models. Families and tiers are fixed by the design (§2); ids are pinned at freeze.
  "models": {
    "A": {"roles": ["generator", "reviewer"], "family": 1, "tier": "strong", "provider": "synthetic_world",
          "model": "synthetic-A-20261009", "snapshot": "synthetic-A-20261009",
          "synthetic": {"base_unsafe": 0.28, "base_accept": 0.88}},
    "B": {"roles": ["generator", "reviewer"], "family": 2, "tier": "strong", "provider": "synthetic_world",
          "model": "synthetic-B-20261009", "snapshot": "synthetic-B-20261009",
          "synthetic": {"base_unsafe": 0.32, "base_accept": 0.87}},
    "C": {"roles": ["generator", "reviewer"], "family": 3, "tier": "strong", "provider": "synthetic_world",
          "model": "synthetic-C-20261009", "snapshot": "synthetic-C-20261009",
          "synthetic": {"base_unsafe": 0.36, "base_accept": 0.86}},
    "a": {"roles": ["reviewer"], "family": 1, "tier": "cheap", "provider": "synthetic_world",
          "model": "synthetic-a-20261009", "snapshot": "synthetic-a-20261009",
          "synthetic": {"base_unsafe": 0.4, "base_accept": 0.86}},
    "b": {"roles": ["reviewer"], "family": 2, "tier": "cheap", "provider": "synthetic_world",
          "model": "synthetic-b-20261009", "snapshot": "synthetic-b-20261009",
          "synthetic": {"base_unsafe": 0.42, "base_accept": 0.85}},
    "c": {"roles": ["reviewer"], "family": 3, "tier": "cheap", "provider": "synthetic_world",
          "model": "synthetic-c-20261009", "snapshot": "synthetic-c-20261009",
          "synthetic": {"base_unsafe": 0.44, "base_accept": 0.85}},
    "X": {"roles": ["generator", "reviewer"], "family": 4, "tier": "open", "provider": "synthetic_world",
          "model": "synthetic-X-20261009", "snapshot": "synthetic-X-20261009", "weights_sha": "a707437a034fe414acbeaacf1b270daf7c94266c5586d12deb353c738870de85", "precision": "synthetic", "serving_stack": "synthetic-world", "gpus": 1,
          "synthetic": {"base_unsafe": 0.46, "base_accept": 0.84}},
    "Y": {"roles": ["generator", "reviewer"], "family": 5, "tier": "open", "provider": "synthetic_world",
          "model": "synthetic-Y-20261009", "snapshot": "synthetic-Y-20261009", "weights_sha": "5fa44058bef4ec3ac8b407f0fa40ca6eb604128d745b4a097ddfc4c21822eb4c", "precision": "synthetic", "serving_stack": "synthetic-world", "gpus": 1,
          "synthetic": {"base_unsafe": 0.48, "base_accept": 0.84}},
    "Z": {"roles": ["generator", "reviewer"], "family": 6, "tier": "open", "provider": "synthetic_world",
          "model": "synthetic-Z-20261009", "snapshot": "synthetic-Z-20261009", "weights_sha": "09c9aeab7c66b7878f0d88a46bffb264b2d5897b379840b15572d446bc3e6b89", "precision": "synthetic", "serving_stack": "synthetic-world", "gpus": 1,
          "synthetic": {"base_unsafe": 0.5, "base_accept": 0.83}}
  },

  // Q17: one pin rule per provider (regex the model id and the served snapshot must match).
  // Provisional shapes; confirm against each provider's snapshot naming at freeze.
  "pin_rules": {"anthropic": "(\\d{8}|\\d{4}-\\d{2}-\\d{2})$",
                "openai": "\\d{4}-\\d{2}-\\d{2}$",
                "google": "(-\\d{3}|\\d{4}-\\d{2}-\\d{2}|\\d{2}-\\d{4})$"},
  "allowed_precisions": ["synthetic"],

  "sampling": {
    "gen_temperature": 0.7,                           // [default §6] generation sampling
    "gen_top_p": 1.0,                                 // [default §6]
    "review_temperature": 0.7,                        // §6, fixed: three trials must be able to differ
    "review_top_p": 1.0,                              // §6, fixed
    "reasoning": "medium_or_equivalent"               // [default §6] same nominal setting for every model
  },
  "caps": {
    "gen_output_tokens": 8000,                        // [default §6]
    "review_input_tokens": 8000,                      // [default §6] bytes/4 proxy (Q11)
    "review_output_tokens": 2000,                     // [default §6]
    "packet_tokens": 3000,                            // [default §6, v1.0 §13] Experiment B packets
    "context_lines": 50,                              // §11.1 enclosing method ±50 lines
    "justification_words": 150,                       // §11.3 recorded, never invalidating (Q4)
    "sibling_target_lines": 10                        // §9 flagged target, not enforced (Q15)
  },
  "timeouts_s": {
    "review_timeout_s": 120,                          // [default §6]
    "gen_timeout_s": 300                              // [default §6]
  },
  "max_attempts": 4,                                  // §6: one call + at most 3 retries, counted across resumes (Q1)
  "workers": 8,
  "design": {"trials": 3, "attempts_per_cell": 10, "reruns": 10, "gate_k": 2, "gate_n": 3},

  // SYNTHETIC UNIT COSTS (not prices): strong 10/30, cheap 1/3, open 2/6 per million tokens.
  "prices_usd_per_mtok": {
    "A": {"input": 10, "output": 30},
    "B": {"input": 10, "output": 30},
    "C": {"input": 10, "output": 30},
    "a": {"input": 1, "output": 3},
    "b": {"input": 1, "output": 3},
    "c": {"input": 1, "output": 3},
    "X": {"input": 2, "output": 6},
    "Y": {"input": 2, "output": 6},
    "Z": {"input": 2, "output": 6}
  },
  "openweight_cost": {"primary": "hosted_price", "sensitivity": "gpu_seconds",
                      "gpu_hour_usd": 1.0},

  "acceptance_target": 0.90,                          // §6 alpha: corrected acceptance target
  "margins": {
    "sesoi_unsafe": 0.10,                             // [default §6] smallest effect of interest on U
    "ni_accept": 0.10,                                // [default §6] non-inferiority margin on A
    "ni_unsafe": 0.10                                 // [default §6] non-inferiority margin on U (RQ2)
  },
  "alpha_one_sided": 0.025,                           // Q8: one-sided 0.025 = two-sided 0.05
  "bootstrap": {"regret_draws": 200, "confirm_draws": 400},     // reduced for the offline self-test; live requires 2000 / 10000
  "regret": {"delta": 0.05, "stability_share": 0.80},           // §12.4

  "experiment_b": {"n_cves": 12, "reviewers": ["a", "b", "c"],
                   "packets": ["structure", "ordinary_tests", "contracts"]},

  "extension": {
    "enabled": true,                                  // author decision 8 Oct; must be explicit (Q21)
    "paid_block_on_test": true,                       // [extension default §12.7]
    "rq2o_mode": "promotion_rule",                    // [extension default §15.7] or "fixed_sequence"
    "promotion": {"ni_unsafe": 0.05, "ni_accept": 0.05, "max_half_width": 0.10}   // §15.7 (i)-(iii)
  },

  "stage1": {"suite_scope": "full"},                  // [default §8, Q19] or "module_fallback"
  "sibling": {"method": "author",                     // [default §9] author corrects by hand
              "input_dir": "runs/synthetic/inputs/siblings"},
  "vul4j": {"runner": "mock"},

  // Synthetic world: planted structure the analysis must recover (see hp/synthworld.py).
  "synthetic_world": {
    "cve_limit": {"development": 8, "test": 12},     // null = every CVE in the split (selftest --full)
    "ineligible_share": {"build_fail": 0.04, "pov_unstable": 0.04, "suite_unstable": 0.04},
    "flaky_tests_per_cve": 1,
    "variants_per_generator": 5,
    "outcome_probs": {"apply_fail": 0.05, "build_fail": 0.05, "regression_fail": 0.10,
                      "blocked": 0.30, "near_miss": 0.45, "indeterminate": 0.05},
    "sibling_infeasible_share": 0.03,
    "difficulty_sd": 0.12,
    "concentrated": {"share": 0.08, "members": ["a", "b", "c"]},
    "blind_spot": 0.15,
    "same_family": 0.05,
    "open_generator_shift": 0.05,
    "failures": {"timeout": 0.01, "truncated": 0.005, "schema_invalid": 0.005, "abstain": 0.01,
                 "persistent_share": 0.3}
  },

  "freeze": {"frozen": false, "config_sha256": null, "code_sha256": null}
}
