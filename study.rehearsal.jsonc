// Study configuration: Experiment Specification v1.3 (REHEARSAL mode).
//
// The real pipeline (pinned Vul4J container, real model calls through Ollama) with every
// model slot served by open weights, so the whole system can be run end to end before any
// API key exists. A rehearsal never makes a paid call, never touches the test split, can
// never be frozen and writes its own logs (runs/rehearsal). Its numbers are not results.
//
// To turn it into the live study: copy study.jsonc, keep this file's vul4j and X/Y/Z
// blocks, and pin the six commercial models there.
{
  "study": "llm-security-review",
  "spec_version": "1.3",
  "mode": "rehearsal",
  "seed": 20260930,                                   // §6 global seed; every derived seed is logged
  "split": {"file": "docs/spec/proposed_split.json",
            "sha256": "b0ffb4cf5723e4c21480cef1b704ed6abdbf889d4f072a2316986a04219445d7"},
  "paths": {"runs": "runs/rehearsal", "inputs": "bank_inputs"},
  "prompts": {"review": "prompts/review_v13.md", "generate": "prompts/generate_v13.md",
              "sibling": "prompts/sibling_v13.md"},

  // Nine slots, every one an open-weight stand-in served by Ollama on the study host.
  // A/B/C and a/b/c stand in for the commercial models: their outputs test the pipeline,
  // not the design. X/Y/Z are the extension models proposed for the live study.
  // A/B/C use the SAME weights and context length as X/Y/Z, so Ollama keeps one loaded
  // instance per model: six distinct models (~102 GB of weights) fit two H100s with
  // their context caches, instead of nine models evicting each other.
  // weights_sha / precision / serving_stack are facts read from the server:
  //   python study.py pin study.rehearsal.jsonc --write   (also pins the Vul4J image)
  // think: false keeps calls fast (pilot, 13 Oct: thinking made calls ~60x slower).
  // Devstral has no thinking mode. Identity terms: product names, as words (leak scan).
  "models": {
    "A": {"roles": ["generator", "reviewer"], "family": 1, "tier": "strong", "provider": "openweight",
          "model": "qwen3.8:27b-q8_0", "weights_sha": "TO_PIN_AT_FREEZE", "precision": "TO_PIN_AT_FREEZE",
          "serving_stack": "TO_PIN_AT_FREEZE", "host": "http://localhost:11434", "num_ctx": 65536,
          "gpus": 1, "reload_threshold_s": 1.0, "keep_alive": "60m",
          "reasoning_params": {"think": false}, "identity_terms": ["Qwen", "Alibaba"],
          "send_temperature": true, "send_top_p": true, "deviation_note": ""},
    "B": {"roles": ["generator", "reviewer"], "family": 2, "tier": "strong", "provider": "openweight",
          "model": "granite4.2:30b-q8_0", "weights_sha": "TO_PIN_AT_FREEZE", "precision": "TO_PIN_AT_FREEZE",
          "serving_stack": "TO_PIN_AT_FREEZE", "host": "http://localhost:11434", "num_ctx": 65536,
          "gpus": 1, "reload_threshold_s": 1.0, "keep_alive": "60m",
          "reasoning_params": {"think": false}, "identity_terms": ["Granite"],
          "send_temperature": true, "send_top_p": true, "deviation_note": ""},
    "C": {"roles": ["generator", "reviewer"], "family": 3, "tier": "strong", "provider": "openweight",
          "model": "devstral-small-2:24b-instruct-2512-q8_0", "weights_sha": "TO_PIN_AT_FREEZE", "precision": "TO_PIN_AT_FREEZE",
          "serving_stack": "TO_PIN_AT_FREEZE", "host": "http://localhost:11434", "num_ctx": 65536,
          "gpus": 1, "reload_threshold_s": 1.0, "keep_alive": "60m",
          "reasoning_params": {}, "identity_terms": ["Devstral", "Mistral"],
          "send_temperature": true, "send_top_p": true, "deviation_note": "no thinking mode; reasoning setting not applicable"},
    "a": {"roles": ["reviewer"], "family": 1, "tier": "cheap", "provider": "openweight",
          "model": "qwen3.5:4b", "weights_sha": "TO_PIN_AT_FREEZE", "precision": "TO_PIN_AT_FREEZE",
          "serving_stack": "TO_PIN_AT_FREEZE", "host": "http://localhost:11434", "num_ctx": 16384,
          "gpus": 1, "reload_threshold_s": 1.0, "keep_alive": "60m",
          "reasoning_params": {"think": false}, "identity_terms": ["Qwen", "Alibaba"],
          "send_temperature": true, "send_top_p": true, "deviation_note": ""},
    "b": {"roles": ["reviewer"], "family": 2, "tier": "cheap", "provider": "openweight",
          "model": "granite4.2:8b", "weights_sha": "TO_PIN_AT_FREEZE", "precision": "TO_PIN_AT_FREEZE",
          "serving_stack": "TO_PIN_AT_FREEZE", "host": "http://localhost:11434", "num_ctx": 16384,
          "gpus": 1, "reload_threshold_s": 1.0, "keep_alive": "60m",
          "reasoning_params": {"think": false}, "identity_terms": ["Granite"],
          "send_temperature": true, "send_top_p": true, "deviation_note": ""},
    "c": {"roles": ["reviewer"], "family": 3, "tier": "cheap", "provider": "openweight",
          "model": "gemma4:e4b", "weights_sha": "TO_PIN_AT_FREEZE", "precision": "TO_PIN_AT_FREEZE",
          "serving_stack": "TO_PIN_AT_FREEZE", "host": "http://localhost:11434", "num_ctx": 16384,
          "gpus": 1, "reload_threshold_s": 1.0, "keep_alive": "60m",
          "reasoning_params": {"think": false}, "identity_terms": ["Gemma", "Gemini"],
          "send_temperature": true, "send_top_p": true, "deviation_note": ""},
    "X": {"roles": ["generator", "reviewer"], "family": 4, "tier": "open", "provider": "openweight",
          "model": "qwen3.8:27b-q8_0", "weights_sha": "TO_PIN_AT_FREEZE", "precision": "TO_PIN_AT_FREEZE",
          "serving_stack": "TO_PIN_AT_FREEZE", "host": "http://localhost:11434", "num_ctx": 65536,
          "gpus": 1, "reload_threshold_s": 1.0, "keep_alive": "60m",
          "reasoning_params": {"think": false}, "identity_terms": ["Qwen", "Alibaba"],
          "send_temperature": true, "send_top_p": true, "deviation_note": ""},
    "Y": {"roles": ["generator", "reviewer"], "family": 5, "tier": "open", "provider": "openweight",
          "model": "granite4.2:30b-q8_0", "weights_sha": "TO_PIN_AT_FREEZE", "precision": "TO_PIN_AT_FREEZE",
          "serving_stack": "TO_PIN_AT_FREEZE", "host": "http://localhost:11434", "num_ctx": 65536,
          "gpus": 1, "reload_threshold_s": 1.0, "keep_alive": "60m",
          "reasoning_params": {"think": false}, "identity_terms": ["Granite"],
          "send_temperature": true, "send_top_p": true, "deviation_note": ""},
    "Z": {"roles": ["generator", "reviewer"], "family": 6, "tier": "open", "provider": "openweight",
          "model": "devstral-small-2:24b-instruct-2512-q8_0", "weights_sha": "TO_PIN_AT_FREEZE",
          "precision": "TO_PIN_AT_FREEZE", "serving_stack": "TO_PIN_AT_FREEZE",
          "host": "http://localhost:11434", "num_ctx": 65536,
          "gpus": 1, "reload_threshold_s": 1.0, "keep_alive": "60m",
          "reasoning_params": {}, "identity_terms": ["Devstral", "Mistral"],
          "send_temperature": true, "send_top_p": true,
          "deviation_note": "no thinking mode; reasoning setting not applicable"}
  },

  // Q17: one pin rule per provider (regex the model id and the served snapshot must match).
  // Provisional shapes; confirm against each provider's snapshot naming at freeze.
  "pin_rules": {"anthropic": "(\\d{8}|\\d{4}-\\d{2}-\\d{2})$",
                "openai": "\\d{4}-\\d{2}-\\d{2}$",
                "google": "(-\\d{3}|\\d{4}-\\d{2}-\\d{2}|\\d{2}-\\d{4})$"},
  "allowed_precisions": ["Q4_K_M", "Q8_0", "MXFP4", "BF16", "F16"],

  "sampling": {
    "gen_temperature": 0.7,                           // [default §6] generation sampling
    "gen_top_p": 1.0,                                 // [default §6]
    "review_temperature": 0.7,                        // §6, fixed: three trials must be able to differ
    "review_top_p": 1.0,                              // §6, fixed
    "reasoning": "per_model_reasoning_params"        // [default §6] rehearsal: thinking off where possible (see models), not the study setting
  },
  "caps": {
    "gen_output_tokens": 8000,                        // [default §6]
    "review_input_tokens": 8000,                      // [default §6] bytes/4 proxy (Q11)
    "review_output_tokens": 2000,                     // [default §6]
    "packet_tokens": 3000,                            // [default §6, v1.0 §13] Experiment B packets
    "context_lines": 50,                              // §11.1 enclosing method ±50 lines
    "justification_words": 150,                       // §11.3 recorded, never invalidating (Q4)
    "sibling_target_lines": 10                        // §9 flagged target, not enforced (Q15)
  },
  "timeouts_s": {
    "review_timeout_s": 120,                          // [default §6]
    "gen_timeout_s": 300                              // [default §6]
  },
  "max_attempts": 4,                                  // §6: one call + at most 3 retries, counted across resumes (Q1)
  "workers": 4,
  "design": {"trials": 3, "attempts_per_cell": 10, "reruns": 10, "gate_k": 2, "gate_n": 3},

  "prices_usd_per_mtok": {   // rehearsal: nominal prices, they only exercise the cost code
    "A": {"input": 1.0, "output": 4.0},
    "B": {"input": 1.0, "output": 4.0},
    "C": {"input": 1.0, "output": 4.0},
    "a": {"input": 1.0, "output": 4.0},
    "b": {"input": 1.0, "output": 4.0},
    "c": {"input": 1.0, "output": 4.0},
    "X": {"input": 1.0, "output": 4.0},   // hosted-provider price (primary)
    "Y": {"input": 1.0, "output": 4.0},
    "Z": {"input": 1.0, "output": 4.0}
  },
  "openweight_cost": {"primary": "hosted_price", "sensitivity": "gpu_seconds",
                      "gpu_hour_usd": 7.0},

  "acceptance_target": 0.90,                          // §6 alpha: corrected acceptance target
  "margins": {
    "sesoi_unsafe": 0.10,                             // [default §6] smallest effect of interest on U
    "ni_accept": 0.10,                                // [default §6] non-inferiority margin on A
    "ni_unsafe": 0.10                                 // [default §6] non-inferiority margin on U (RQ2)
  },
  "alpha_one_sided": 0.025,                           // Q8: one-sided 0.025 = two-sided 0.05
  "bootstrap": {"regret_draws": 200, "confirm_draws": 200},   // §12.4, §15.2
  "regret": {"delta": 0.05, "stability_share": 0.80},           // §12.4

  "experiment_b": {"n_cves": 12, "reviewers": ["a", "b", "c"],
                   "packets": ["structure", "ordinary_tests", "contracts"]},

  "extension": {
    "enabled": true,                                  // author decision 8 Oct; must be explicit (Q21)
    "paid_block_on_test": true,                       // [extension default §12.7]
    "rq2o_mode": "promotion_rule",                    // [extension default §15.7] or "fixed_sequence"
    "promotion": {"ni_unsafe": 0.05, "ni_accept": 0.05, "max_half_width": 0.10}   // §15.7 (i)-(iii)
  },

  "stage1": {"suite_scope": "full"},                  // [default §8, Q19] or "module_fallback"
  "sibling": {"method": "openweight_model",           // [default §9] rehearsal: Z drafts the twins (the spec's sensitivity method); the study uses "author"
              "model_ref": "Z",
              "input_dir": "bank_inputs/siblings"},
  "vul4j": {"runner": "container",
            "image": "vul4j:376411d",                 // built by scripts/azure/setup.sh from Vul4J commit 376411d
            "source_commit": "376411da11fa705019f731404de1d0679fe73537",
            "image_digest": "TO_PIN_AT_FREEZE",       // python study.py pin CONFIG --write
            "pin_kind": "image_id",                   // a local build is pinned by image id; a pulled image by repo digest
            "platform": "linux/amd64",                // the image is published for amd64 only
            "network": "none",                        // dependency caches are inside the image; "bridge" if a build needs the network (record it)
            "cli": "vul4j", "workdir": "/data/vul4j-work",
            "cpus_per_container": 8, "memory_per_container": "48g",
            "checkout_timeout_s": 1800, "compile_timeout_s": 3600, "test_timeout_s": 7200},

  "freeze": {"frozen": false, "config_sha256": null, "code_sha256": null}
}
